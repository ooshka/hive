#!/usr/bin/env bash
# wtlog — view a worktree agent's stream-json log through a readable formatter.
#
#   wtlog <worktree-path|log-file> [--raw] [--no-follow]
#
#   --raw         pretty-print full JSON events (jq -C .) instead of one-line summary
#   --no-follow   print the current tail and exit (used by the wtagents fzf preview)
#
# The agent log is newline-delimited stream-json (see the `worktree` skill). The
# default view renders one readable line per event and tolerates the non-JSON
# stdin-warning line the agent emits at startup.
set -euo pipefail

target="${1:?usage: wtlog <worktree-path|log-file> [--raw] [--no-follow]}"; shift || true
raw=0; follow=1
for a in "$@"; do
  case "$a" in
    --raw)       raw=1 ;;
    --no-follow) follow=0 ;;
    *) echo "wtlog: unknown arg: $a" >&2; exit 2 ;;
  esac
done

if [ -d "$target" ]; then log="$target/.claude/agent.log"
elif [ -f "$target" ]; then log="$target"
else echo "wtlog: not found: $target" >&2; exit 1; fi
[ -f "$log" ] || { echo "wtlog: no log at $log (agent may not have started)" >&2; exit 1; }

# One readable line per event; passes non-JSON lines (e.g. the stdin warning)
# through dimmed. ANSI written as  escapes so the source stays editable.
FMT='
  . as $raw
  | (try fromjson catch null) as $e
  | if $e == null then "[2m  · \($raw)[0m"
    elif ($e.type=="system" and $e.subtype=="init") then
      "[2m▸ init  model=\($e.model)  tools=\($e.tools|length)[0m"
    elif $e.type=="assistant" then
      ( ($e.message.content // [])
        | map( if .type=="text" then (.text // "")
               elif .type=="tool_use" then "[36m⚙ \(.name)[0m(" + ((.input|tojson)[0:80]) + ")"
               else "[\(.type)]" end)
        | map(select(length>0)) | join("  ") ) | select(length>0) | "🗣 " + .
    elif $e.type=="user" then
      ( ($e.message.content // [])
        | map( if .type=="tool_result"
               then "[2m← [0m" + (if .is_error then "[31mERR [0m" else "" end)
                    + ((if (.content|type)=="array" then (.content|map(.text//"")|join(" ")) else (.content|tostring) end)[0:80])
               else "[\(.type)]" end)
        | join("  ") )
    elif $e.type=="result" then
      (if $e.is_error then "[31m✗" else "[32m✓" end)
      + " \($e.subtype)[0m  turns=\($e.num_turns)  $\((($e.total_cost_usd // 0)*1000|round)/1000)  \"\(($e.result // "")[0:60])\""
    elif $e.type=="rate_limit_event" then empty
    else "[2m· [\($e.type)][0m" end
'

run() { if [ "$raw" -eq 1 ]; then jq -R -C 'fromjson? // .'; else jq -Rr "$FMT"; fi; }

if [ "$follow" -eq 1 ]; then
  tail -n 200 -f "$log" | run
else
  tail -n "${WTLOG_LINES:-60}" "$log" | run
fi
