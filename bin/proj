#!/usr/bin/env bash
# proj — fuzzy project switcher for zellij agent workspaces.
#
#   proj            fzf-pick a project, open/attach its "agent" session
#   proj <query>    pre-filter the fzf list (auto-selects on a single match)
#
# Each project gets a zellij session named after its directory, running the
# `agent` layout (claude / nvim / lazygit tabs). Re-running for the same
# project re-attaches to the live session instead of spawning a duplicate.
set -euo pipefail

# Project roots (colon-separated). Override with PROJ_ROOTS=/a:/b proj
DEFAULT_ROOTS="$HOME/projects"
IFS=':' read -r -a ROOTS <<< "${PROJ_ROOTS:-$DEFAULT_ROOTS}"

list_projects() {
  for root in "${ROOTS[@]}"; do
    [ -d "$root" ] || continue
    find "$root" -mindepth 1 -maxdepth 1 -type d 2>/dev/null
  done | sort
}

query="${1:-}"
if [ -n "$query" ] && [ -d "$query" ]; then
  selected="$query"                       # explicit path wins
else
  selected="$(list_projects | fzf --query "$query" --select-1 --exit-0 \
                --prompt 'project> ' --height 40% --reverse)"
fi
[ -z "${selected:-}" ] && exit 0          # user cancelled

selected="$(realpath "$selected")"
# zellij session names allow [A-Za-z0-9_-]; map everything else to '_'.
base="$(basename "$selected")"
name="${base//[^A-Za-z0-9_-]/_}"

# `proj` creates/attaches from OUTSIDE a session. To move between sessions while
# inside zellij, use the session manager (Alt-s, or Ctrl-o w) — no need for proj.
if [ -n "${ZELLIJ:-}" ]; then
  echo "Already inside zellij ($ZELLIJ)." >&2
  echo "Swap/create sessions on the fly with Alt-s (session manager)." >&2
  echo "Or detach with Ctrl-o d, then run 'proj' from the shell." >&2
  exit 1
fi

cd "$selected"
# With session_serialization disabled (config.kdl), closed sessions vanish — so a
# name that still appears is LIVE. Attach to it; otherwise start a fresh agent
# session. (The check lives in the `if` condition, which `set -e` exempts, so an
# empty session list — where `zellij list-sessions` exits non-zero — is safe.)
if zellij list-sessions -s 2>/dev/null | grep -qx "$name"; then
  exec zellij attach "$name"        # live → reattach
else
  exec zellij -s "$name" -n agent   # not running → fresh layout
fi
