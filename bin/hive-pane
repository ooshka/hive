#!/usr/bin/env bash
# hive-pane — label a tab's pane "<label> - <project>" then exec a tool.
#
#   hive-pane <label> <command> [args...]
#
# The agent layout runs each tab through this. It renames the zellij pane to
# "<label> - <project>" (project = the session name) so the pane frame shows
# which project you're in, e.g. "Claude - dev-globe", and also sets the host
# terminal's window title to match. The rename pins the frame label, so it
# survives whatever the tool does to its own title afterwards.
set -euo pipefail

label="$1"; shift
project="${ZELLIJ_SESSION_NAME:-shell}"
title="$label - $project"

# Pane frame label (the visible title in zellij). Renames *this* pane by id so it
# works regardless of which tab is focused at startup.
if [ -n "${ZELLIJ_PANE_ID:-}" ]; then
  zellij action rename-pane --pane-id "$ZELLIJ_PANE_ID" "$title" 2>/dev/null || true
fi

# Host terminal window title too (e.g. the Windows Terminal tab), best-effort.
printf '\033]0;%s\007' "$title"

exec "$@"
