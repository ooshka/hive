#!/usr/bin/env bash
# wtagents — manage worktree agents from inside zellij (bound to Alt-g).
#
# fzf picker over the worktree agents fleet discovers, with a live log preview.
#   enter   → open the agent's log (live tail, readable stream-json) in a pane
#   ctrl-k  → kill the agent (with confirmation)
#   ctrl-e  → open nvim on the worktree (floating)
#
# Read-only "what's running" stays in the fleet tab (Alt-4); this is the control
# surface. (Worktree agents are headless — there's intentionally no "attach".)
set -euo pipefail

if [ -z "${ZELLIJ:-}" ]; then
  echo "wtagents: only works inside a zellij session (Alt-g)." >&2
  exit 1
fi

# One row per agent: "<icon> repo/name  [status age]  activity \t <path>".
list() {
  fleet --json | jq -r '
    .worktrees[]
    | ({running:"●",done:"✓",failed:"✗",stopped:"·"}[.status] // "·") as $i
    | "\($i) \(.repo)/\(.name)  [\(.status) \(.age)]  \(((.activity // "")|gsub("[\t\n]";" "))[0:48])\t\(.path)"
  '
}

rows="$(list || true)"
if [ -z "$rows" ]; then
  echo "No worktree agents under ${WORKTREE_BASE:-$HOME/projects/worktrees}."
  echo "Spawn one with the worktree skill (create … --launch \"<task>\")."
  echo
  read -rsn1 -p "(press any key to close)"
  exit 0
fi

out="$(printf '%s\n' "$rows" | fzf --delimiter='\t' --with-nth=1 \
        --prompt 'worktree agent> ' --height 100% --reverse --no-multi \
        --expect=ctrl-k,ctrl-e \
        --preview 'wtlog {2} --no-follow' --preview-window 'right,58%,wrap' \
        --header 'enter=tail log   ctrl-k=kill   ctrl-e=nvim edit')"
[ -z "${out:-}" ] && exit 0

key="$(printf '%s' "$out" | head -1)"
sel="$(printf '%s' "$out" | sed -n '2p')"
[ -z "${sel:-}" ] && exit 0
path="$(printf '%s' "$sel" | cut -f2)"
name="$(basename "$path")"

case "$key" in
  ctrl-k)
    printf 'Kill worktree agent "%s" ? [y/N] ' "$name"
    read -r ans
    case "$ans" in
      y|Y) wtkill "$path"; echo; read -rsn1 -p "(any key)";;
      *)   echo "cancelled"; sleep 0.5;;
    esac
    ;;
  ctrl-e)
    exec wtedit "$path"
    ;;
  *)  # enter → live log tail in a floating pane (Ctrl-c the tail to close it)
    exec zellij action new-pane --floating --close-on-exit --name "log:$name" -- wtlog "$path"
    ;;
esac
