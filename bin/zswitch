#!/usr/bin/env bash
# zswitch — open OR switch projects from inside zellij (bound to Alt-s).
#
# Lists every project under PROJ_ROOTS plus any other live sessions. On
# selection it switches to that session, creating a fresh `agent` session in the
# project's directory if it isn't already running. So this both *switches*
# between open projects and *opens* new ones — no need to detach to a shell.
#
# `proj` is the shell-side counterpart (run before entering zellij); inside
# zellij, use this (Alt-s).
set -euo pipefail

if [ -z "${ZELLIJ:-}" ]; then
  echo "zswitch: only works inside a zellij session." >&2
  exit 1
fi

# Project roots (colon-separated). Mirrors `proj`. Override with PROJ_ROOTS.
DEFAULT_ROOTS="$HOME/projects"
IFS=':' read -r -a ROOTS <<< "${PROJ_ROOTS:-$DEFAULT_ROOTS}"
current="${ZELLIJ_SESSION_NAME:-}"

# zellij session names allow [A-Za-z0-9_-]; map everything else to '_' (same as proj).
sanitize() { local b; b="$(basename "$1")"; printf '%s' "${b//[^A-Za-z0-9_-]/_}"; }

# Live session names (drop EXITED stubs).
mapfile -t live < <(
  zellij list-sessions --no-formatting 2>/dev/null \
    | grep 'Created' | grep -v 'EXITED' | awk '{print $1}'
)
is_live() { local n="$1" s; for s in "${live[@]}"; do [ "$s" = "$n" ] && return 0; done; return 1; }

# Build a TAB-separated menu: "<tag><name>\t<path>". fzf shows column 1 only.
declare -A seen
menu=""
for root in "${ROOTS[@]}"; do
  [ -d "$root" ] || continue
  while IFS= read -r dir; do
    name="$(sanitize "$dir")"
    [ "$name" = "$current" ] && continue          # skip the project we're in
    seen["$name"]=1
    if is_live "$name"; then tag="● "; else tag="  "; fi
    menu+="${tag}${name}"$'\t'"${dir}"$'\n'
  done < <(find "$root" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort)
done
# Live sessions that aren't projects under a root (e.g. ad-hoc `agent` workspaces).
for s in "${live[@]}"; do
  [ "$s" = "$current" ] && continue
  [ -n "${seen[$s]:-}" ] && continue
  menu+="● ${s}"$'\t'$'\n'
done

if [ -z "$menu" ]; then
  echo "No other projects or live sessions to open/switch to."
  read -rsn1 -p "(press any key to close)"
  exit 0
fi

pick="$(printf '%s' "$menu" | fzf --with-nth=1 --delimiter=$'\t' \
        --prompt 'open/switch> ' --height 100% --reverse --no-multi)"
[ -z "${pick:-}" ] && exit 0

name="$(printf '%s' "$pick" | cut -f1 | sed 's/^[● ]*//')"
path="$(printf '%s' "$pick" | cut -f2)"

if is_live "$name" || [ -z "$path" ]; then
  exec zellij action switch-session "$name"                       # live → just switch
else
  exec zellij action switch-session -c "$path" -l agent "$name"   # new → create + switch
fi
