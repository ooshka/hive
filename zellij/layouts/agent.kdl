// "agent" workspace layout — launch with: zellij --layout agent  (or via `hive open`)
//
//   Hive starts one HIVE_AGENT_DEFAULT assistant tab. Add more with Alt-a.
//   Alt-1 focuses the assistant area, cycling through assistant tabs when
//   already there.
//
//     Alt-1 assistant/cycle   Alt-a new assistant   Alt-x close assistant
//     Alt-s split editor
//     Alt-2 nvim/editor       Alt-3 lazygit         Alt-f fullscreen
//
// Each tool launches through `hive pane <label> <cmd>`, which renames the pane
// to "<label> - <project>" (project = the zellij session name) so you can tell
// which project you're in, e.g. "Claude - dev-globe". Panes inherit the cwd
// zellij is launched from.

layout {
    tab name="assistant-start" focus=true {
        pane {
            name "assistant-start"
            command "hive"
            close_on_exit true
            args "assistant"
        }
    }
    tab name="edit" {
        pane {
            name "editor"
            command "hive"
            args "pane" "Editor" "nvim"
        }
    }
    tab name="git" {
        pane {
            name "lazygit"
            command "hive"
            args "pane" "Git" "lazygit"
        }
    }
}
