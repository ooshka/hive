// "agent" workspace layout — launch with: zellij --layout agent  (or via `proj`)
//
//   Four full-screen tabs, one tool each. Starts focused on claude.
//   Jump between them instantly — switching hides the others and nothing
//   relaunches (each tab's process keeps running in the background).
//
//     Alt-1 claude   Alt-2 nvim (edit)   Alt-3 lazygit (git)   Alt-4 fleet
//
// The fleet tab self-refreshes every 2s, so it's always current when you
// switch to it. Panes inherit the cwd zellij is launched from.

layout {
    tab name="claude" focus=true {
        pane {
            name "claude"
            command "claude"
        }
    }
    tab name="edit" {
        pane {
            name "editor"
            command "nvim"
        }
    }
    tab name="git" {
        pane {
            name "lazygit"
            command "lazygit"
        }
    }
    tab name="fleet" {
        pane {
            name "fleet"
            command "fleet"
            args "--watch"
        }
    }
}
