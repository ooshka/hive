// Zellij config — agent-orchestration setup
// Docs: https://zellij.dev/documentation/

default_shell "bash"

// Don't serialize sessions for resurrection. Closing a session ends it cleanly
// instead of leaving an "(EXITED - attach to resurrect)" stub that resurrects
// into a broken single-pane shell. (Detached *live* sessions are unaffected.)
session_serialization false

// Copy yanked text straight to the host clipboard. The shell wrapper keeps one
// config portable across macOS, WSL, Wayland, and X11.
copy_command "bash -lc 'if command -v pbcopy >/dev/null 2>&1; then pbcopy; elif command -v win32yank.exe >/dev/null 2>&1; then win32yank.exe -i --crlf; elif command -v wl-copy >/dev/null 2>&1; then wl-copy; elif command -v xclip >/dev/null 2>&1; then xclip -selection clipboard; else cat >/dev/null; fi'"
copy_clipboard "system"

// Keep pane frames so panes (assistant / editor / lazygit) are labelled.
pane_frames true

// Custom keybinds are MERGED on top of the defaults (defaults stay intact).
// Jump straight to a tool's tab. Alt-based (not Ctrl-) to avoid clobbering
// nvim's Ctrl- keys. Switching tabs never restarts the tool in that tab.
keybinds {
    shared_except "locked" {
        bind "Alt 1" {
            MessagePlugin "hive-orchestrator" {
                name "focus-agent"
            }
        }
        bind "Alt a" {
            Run "hive" "assistant-spawn" {
                floating true
                close_on_exit true
                width "1"
                height "1"
            }
        }
        bind "Alt x" {
            MessagePlugin "hive-orchestrator" {
                name "close-agent"
            }
        }
        bind "Alt 2" {
            MessagePlugin "hive-orchestrator" {
                name "focus-editor"
            }
        }
        bind "Alt 3" {
            MessagePlugin "hive-orchestrator" {
                name "focus-git"
            }
        }
        bind "Alt s" {
            MessagePlugin "hive-orchestrator" {
                name "toggle-split"
            }
        }
        bind "Alt f" { ToggleFocusFullscreen; }

        // Alt-d -> detach (leave the session running in the background).
        bind "Alt d" { Detach; }

        // Alt-w -> close the current project (kill its session) but stay in
        // zellij by switching to another live session first. Unlike Ctrl-q,
        // which quits zellij entirely.
        bind "Alt w" {
            Run "hive" "close" {
                floating true
                close_on_exit true
                width "50%"
                height "55%"
                x "25%"
                y "20%"
            }
        }
    }
}

plugins {
    hive-orchestrator location="file:~/.config/zellij/plugins/hive-orchestrator.wasm"
}

load_plugins {
    "hive-orchestrator"
}
