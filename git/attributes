# Global git attributes — WSL-native (LF) world.
# Normalize all text files to LF in the repo and in the working tree.
* text=auto eol=lf

# Windows-only script/solution files that genuinely expect CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.sln   text eol=crlf

# Common binaries — never touch line endings (text=auto usually detects these,
# but being explicit avoids surprises).
*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.jar   binary
*.class binary
*.exe   binary
*.dll   binary
